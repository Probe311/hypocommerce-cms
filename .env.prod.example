APP_ENV=prod
APP_DEBUG=0
APP_URL=https://hypocommerce.example.com
APP_VERSION=1.1.0
APP_SECRET=replace-with-strong-secret
CORS_ALLOW_ORIGIN=https://shop.example.com

DB_HOST=db
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=ecommerce_user
DB_PASSWORD=replace-with-strong-password
DB_CONNECT_TIMEOUT=5
DB_SSL_CA=
DB_SSL_VERIFY=1

JWT_SECRET=replace-with-strong-secret
ADMIN_API_TOKEN=replace-with-strong-token
ALLOW_LEGACY_ADMIN_TOKEN=0
ADMIN_UI_REVIEW_ALLOWED=0

MAILER_DSN=smtp://mailer.internal

STRIPE_SECRET_KEY=replace-with-real-key
STRIPE_WEBHOOK_SECRET=replace-with-real-secret
PAYPAL_CLIENT_ID=replace-with-real-id
PAYPAL_CLIENT_SECRET=replace-with-real-secret
