APP_ENV=dev
APP_DEBUG=1
APP_VERSION=1.1.0
APP_URL=http://localhost:8000
APP_VERSION=1.1.0
APP_SECRET=change-me-app-secret
CORS_ALLOW_ORIGIN=http://localhost:3000

# Variables locales uniquement. Ne pas committer votre fichier `.env`.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=root
DB_PASSWORD=
DB_SOCKET=
DB_CONNECT_TIMEOUT=5
DB_SSL_CA=
DB_SSL_VERIFY=0

JWT_SECRET=change-me
ADMIN_API_TOKEN=change-me-admin-token
ALLOW_LEGACY_ADMIN_TOKEN=0

# Autoriser le header X-UI-Review sans Bearer uniquement en environnement non-prod.
ADMIN_UI_REVIEW_ALLOWED=0

# Identifiants analytics / pixels : configurés dans l’admin (hash #tracking), pas via des variables d’environnement.

MAILER_DSN=smtp://localhost

STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_client_secret
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Runtime shipping providers (optionnels: prioritairement configurables aussi via admin Plugins)
SENDCLOUD_API_BASE=https://panel.sendcloud.sc/api/v2
SENDCLOUD_API_KEY=
SENDCLOUD_API_SECRET=
SENDCLOUD_SHIPPING_METHOD_ID=
SENDCLOUD_CONTRACT_ID=

BOXTAL_QUOTE_ENDPOINT=https://live.sendbox.co/shipping/shipment_delivery_quote
BOXTAL_API_KEY=
BOXTAL_API_SECRET=
BOXTAL_ORIGIN_COUNTRY=FR
BOXTAL_ORIGIN_CITY=Paris
BOXTAL_ORIGIN_POSTCODE=75001

# Runtime shipping providers (generic contracts per plugin config)
COLISSIMO_API_BASE=
COLISSIMO_QUOTE_PATH=/quotes
COLISSIMO_API_KEY=
COLISSIMO_ACCOUNT_ID=

MONDIAL_RELAY_API_BASE=
MONDIAL_RELAY_QUOTE_PATH=/quotes
MONDIAL_RELAY_API_KEY=
MONDIAL_RELAY_ACCOUNT_ID=

RELAIS_COLIS_API_BASE=
RELAIS_COLIS_QUOTE_PATH=/quotes
RELAIS_COLIS_API_KEY=
RELAIS_COLIS_ACCOUNT_ID=

CHRONOPOST_API_BASE=
