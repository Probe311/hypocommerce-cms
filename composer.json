{
  "name": "nexora/nexora-cms",
  "description": "Nexora CMS: open-source PHP e-commerce backend with GraphQL API",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ramsey/uuid": "^4.7",
    "vlucas/phpdotenv": "^5.6",
    "webonyx/graphql-php": "^15.0",
    "symfony/http-foundation": "^7.0",
    "symfony/mailer": "^7.0",
    "monolog/monolog": "^3.0",
    "stripe/stripe-php": "^15.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.12",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "lint": "php -l public/index.php && php -l src/Infrastructure/Http/Kernel.php",
    "analyse": "phpstan analyse --configuration phpstan.neon --no-progress --memory-limit=512M",
    "format:check": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
    "format": "php-cs-fixer fix --config=.php-cs-fixer.php",
    "security:audit": "composer audit --no-interaction",
    "security:sast": "phpstan analyse src/Infrastructure src/Application --configuration phpstan.neon --no-progress --memory-limit=512M",
    "test:coverage": "phpunit --configuration phpunit.xml --coverage-clover var/reports/clover.xml --coverage-text",
    "coverage:check": "php bin/check_coverage.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

